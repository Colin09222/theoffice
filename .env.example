# Copy to .env (chmod 600). Never commit it.
AI_MODE=live
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
ADMIN_PASSWORD=
# Exact origin browsers use. CSRF checks and fetch_url's self-block depend on this.
PUBLIC_ORIGIN=https://fakebusiness.io
# Set to 1 because the only way in is a local proxy (Caddy, or the gate on the old address), which puts the real client IP last in X-Forwarded-For.
TRUST_PROXY=1
# Work caps are off unless set: leave these out for unlimited, and only set one if you want it. See "Work caps" in docs/DEPLOY-NEXT.md.
# FLOOR_DAILY_USD=10
# GLOBAL_DAILY_USD=25
# TASK_MAX_USD=40
# MAX_STAFF_STEPS=40   (on at 40 by default; off turns it off)
# LOOP_MAX_RETESTS=2   (failed re-tests per project before the manager stops and asks the boss; off turns it off)
# LOOP_MAX_REPLANS=3   (plan rewrites per project before the same; off turns it off)
# MAX_MANAGER_STEPS=8
# MAX_OPEN_TASKS=14
# MAX_TASKS_PER_DAY=60
# MAX_REVISIONS=2
# MAX_STAFF=8
# What keeps the floors cheap (docs/EFFICIENCY.md). Each is on by default; these are the switches that turn one off.
# AUTOPILOT_IDLE_BACKOFF=0         (a work-mode round every gap again, even when the last one found nothing to do)
# AUTOPILOT_IDLE_MAX_MIN=360       (the longest a quiet floor waits between looks)
# STEPS_KEEP_CHARS=240000          (the old, smaller window for a long run on a cached model; default 400000)
# MANAGER_CACHE_TTL=5m             (the manager's instructions cached for five minutes, not an hour)
# MANAGER_DEDUPE_NOTES=0           (every repeated round note sent to the manager in full)
# LIST_FILES_MAX_CHARS=off         (a file listing however long; default 12000)
# SESSION_FRESH_OVER_TOKENS=off    (work sent back always returns to the same computer; default 250000)
# What the whole building may ever spend with each provider, counted over the whole ledger. Only the admin sees these. Raise one and restart to carry on.
BUDGET_ANTHROPIC_USD=120
BUDGET_OPENROUTER_USD=120
# Optional: Brave Search API key. Leave empty and agents simply have no web_search tool.
WEB_SEARCH_API_KEY=
# Real computers for the Builder and Tester (Claude Managed Agents). Requires ANTHROPIC_API_KEY. Off when unset.
COMPUTER_ENABLED=
# Off unless set, like the caps above.
# SESSION_MAX_USD=5
# SESSION_MAX_STEPS=40
# SESSION_MAX_MINUTES=30
# MAX_SESSIONS_FLOOR=2
# MAX_SESSIONS_GLOBAL=4
# MAX_FIX_TURNS=2
# Not a cap: how much of the building's money one session is promised at a time. It gets the next slice whenever it needs one, while there is money.
# SESSION_SLICE_USD=2
# App-grade publishing: each project on <project>--<floor>.<this domain>. Empty keeps sandbox mode. See docs/DEPLOY-REALBUILDS.md first.
APPS_BASE_DOMAIN=middistance.com
APPS_SCHEME=https
# Domain buying. All of these or it stays off. Force-IPv4 is built in. See docs/DEPLOY-LAUNCH.md.
NAMECHEAP_API_USER=
NAMECHEAP_API_KEY=
# hz's public IPv4, which must also be on Namecheap's API allow-list.
NAMECHEAP_CLIENT_IP=
# A domain already in the account. Its registrant details are read for each purchase and never stored.
DOMAIN_CONTACT_SOURCE=
SERVER_IP=
# SERVER_IP6=
DOMAIN_MAX_USD=25
DOMAINS_PER_FLOOR_DAY=2
DOMAINS_GLOBAL_DAY=6
# DOMAIN_TLDS=com,net,org,io,co,app,dev,xyz,site,online,store,tech,club,live,studio
# OpenRouter pictures and design reviews. Needs OPENROUTER_API_KEY above.
# Off unless set.
# IMAGES_PER_FLOOR_DAY=12
# IMAGES_PER_TASK=6
# REVIEWS_PER_FLOOR_DAY=20
# SEARCHES_PER_FLOOR_DAY=60
# Storage per floor. Pictures need room: published files count twice.
FLOOR_QUOTA_MB=100
# iOS foundation. Off until the owner's Apple and Expo accounts exist.
IOS_ENABLED=
IOS_VAULT_ID=
# The help line: a manager can ask the owner's assistant for guidance. Needs no credential. HELP_ENABLED=0 removes the tool.
HELP_ENABLED=1
HELP_TIMEOUT_MIN=30
HELP_PER_FLOOR_DAY=5

# Paid ads on Google Search (Business mode). Off until ADS_PAID_ENABLED=1; see docs/ADS.md. The cap is the building's, admin only.
ADS_PAID_ENABLED=0
AD_MONTHLY_CAP_USD=50
AD_CPC_CEILING_USD=0.50
# The Google Ads account and its OAuth credentials. The server buys the access token from the refresh token in memory.
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=

# How tall the building is. To add floors later, raise this and restart: nothing else changes.
TOWER_FLOORS=10

# The contractor ping (server/contractorping.js): buddehbot hears at once when a job is held, and asks the owner before anything runs. Off unless both are set.
OPENCLAW_HOOK_URL=
OPENCLAW_HOOK_TOKEN=
# The cost alert (server/costalert.js), through the same hook, silent: the owner's assistant appends one line to its own log when one task passes $5,
# a floor's day passes $10, a task is sent back 3 times or a floor starts a first build, and tells the owner only when one task passes $20. On when the hook is set.
# COST_ALERTS=0                    (off)
# COST_ALERT_TASK_USD=5   COST_ALERT_FLOOR_DAY_USD=10   COST_ALERT_SENT_BACK=3   COST_ALERT_TELL_USD=20   COST_ALERTS_PER_HOUR=6
