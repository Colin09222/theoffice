# Copy to .env (chmod 600). Never commit it.
AI_MODE=live
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
ADMIN_PASSWORD=
# Exact origin browsers use. CSRF checks and fetch_url's self-block depend on this.
PUBLIC_ORIGIN=https://iscolinfree.com
# Set to 1 because the only way in is the local gate proxy, which appends the real client IP to X-Forwarded-For.
TRUST_PROXY=1
FLOOR_DAILY_USD=10
GLOBAL_DAILY_USD=25
TASK_MAX_USD=3
# What the whole building may ever spend with each provider, counted over the whole ledger. Only the admin sees these. Raise one and restart to carry on.
BUDGET_ANTHROPIC_USD=120
BUDGET_OPENROUTER_USD=120
# Optional: Brave Search API key. Leave empty and agents simply have no web_search tool.
WEB_SEARCH_API_KEY=
# Real computers for the Builder and Tester (Claude Managed Agents). Requires ANTHROPIC_API_KEY. Off when unset.
COMPUTER_ENABLED=
SESSION_MAX_USD=5
SESSION_MAX_STEPS=40
SESSION_MAX_MINUTES=30
MAX_SESSIONS_FLOOR=2
MAX_SESSIONS_GLOBAL=4
# App-grade publishing: each project on <project>--<floor>.<this domain>. Empty keeps sandbox mode. See docs/DEPLOY-REALBUILDS.md first.
APPS_BASE_DOMAIN=middistance.com
APPS_SCHEME=https
# Domain buying. All of these or it stays off. Force-IPv4 is built in. See docs/DEPLOY-LAUNCH.md.
NAMECHEAP_API_USER=
NAMECHEAP_API_KEY=
# hz's public IPv4, which must also be on Namecheap's API allow-list.
NAMECHEAP_CLIENT_IP=
# A domain already in the account. Its registrant details are read for each purchase and never stored.
DOMAIN_CONTACT_SOURCE=
SERVER_IP=
# SERVER_IP6=
DOMAIN_MAX_USD=25
DOMAINS_PER_FLOOR_DAY=2
DOMAINS_GLOBAL_DAY=6
# DOMAIN_TLDS=com,net,org,io,co,app,dev,xyz,site,online,store,tech,club,live,studio
# OpenRouter pictures and design reviews. Needs OPENROUTER_API_KEY above.
IMAGES_PER_FLOOR_DAY=12
IMAGES_PER_TASK=6
REVIEWS_PER_FLOOR_DAY=20
SEARCHES_PER_FLOOR_DAY=60
# Storage per floor. Pictures need room: published files count twice.
FLOOR_QUOTA_MB=100
# iOS foundation. Off until the owner's Apple and Expo accounts exist.
IOS_ENABLED=
IOS_VAULT_ID=
# The help line: a manager can ask the owner's assistant for guidance. Needs no credential. HELP_ENABLED=0 removes the tool.
HELP_ENABLED=1
HELP_TIMEOUT_MIN=30
HELP_PER_FLOOR_DAY=5
