[Unit]
Description=office-runner edge (proxy for api--<label>.middistance.com, TLS ask, build egress proxy)
Documentation=file:///opt/office-runner/app/README.md
After=network-online.target office-runner.service
Wants=network-online.target office-runner.service

[Service]
Type=simple
Environment=RUNNER_CONFIG=/opt/office-runner/etc/runner.json
ExecStart=/opt/office-runner/bin/node /opt/office-runner/app/src/edge.mjs
LoadCredential=edge-token:/opt/office-runner/secrets/edge.token
Restart=always
RestartSec=2
# The only internet-facing part: a throwaway unprivileged user, no capabilities, read-only system,
# no Docker socket, no secrets other than its own token.
DynamicUser=yes
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
InaccessiblePaths=-/opt/office-runner/secrets -/opt/office-runner/state -/opt/office-runner/volumes -/opt/office-runner/mnt -/opt/office-runner/logs -/var/run/docker.sock -/run/docker.sock -/run/containerd
MemoryMax=256M
TasksMax=64

[Install]
WantedBy=multi-user.target
