{
  "name": "third-party-rising",
  "private": true,
  "version": "0.1.0",
  "description": "Third Party Rising: build scripts. See README.md.",
  "scripts": {
    "setup": "npm --prefix ui install",
    "dev:ui": "npm --prefix ui run dev",
    "build:ui": "npm --prefix ui run build",
    "wasm": "node tools/build-wasm.mjs",
    "test": "cargo test --release",
    "bench": "cargo run --release -p tpr-headless -- --state OH --years 100",
    "playtest": "node tools/playtest.mjs",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0"
  }
}
