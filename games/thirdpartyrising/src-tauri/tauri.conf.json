{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Third Party Rising",
  "version": "0.1.0",
  "identifier": "com.thirdpartyrising.game",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5178",
    "beforeDevCommand": "npm run dev:ui",
    "beforeBuildCommand": "npm run build:ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "Third Party Rising", "width": 1440, "height": 900, "minWidth": 1120, "minHeight": 700, "resizable": true }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "shortDescription": "A real-time political strategy game.",
    "longDescription": "Found a party in any town in America and work your way up. A game: fiction built on public statistics."
  }
}
