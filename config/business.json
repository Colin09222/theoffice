{
  "_comment": "Business mode: the guided Idea, Build, Customers, Launch journey. Off until a boss starts it on their floor. Steps, tracks, chips, ad amounts and the video model all live here. See docs/BUSINESS.md.",
  "steps": [
    { "id": "idea", "label": "Idea" },
    { "id": "build", "label": "Build" },
    { "id": "customers", "label": "Customers" },
    { "id": "launch", "label": "Launch" }
  ],
  "ideas": { "min": 2, "max": 3, "evidenceMin": 2, "evidenceMax": 4, "rounds": 4 },
  "tracks": [
    { "id": "website", "label": "Website", "items": [
      { "task": "look", "role": "designer", "title": "Pick the look", "label": "The look" },
      { "task": "site", "role": "builder", "title": "Build the landing page", "label": "The page", "after": ["look", "offer", "prices"] },
      { "check": "published", "label": "Live on the web" },
      { "check": "domain", "label": "A .com of its own", "optional": true }
    ] },
    { "id": "product", "label": "Product", "items": [
      { "task": "offer", "role": "writer", "title": "Write the offer", "label": "The offer" },
      { "task": "prices", "role": "researcher", "title": "Check what rivals charge", "label": "Rival prices" }
    ] },
    { "id": "payments", "label": "Payments", "note": "No card payments yet: there is no Stripe here. A notify-me sign-up collects the people who want it instead.", "items": [
      { "check": "signup", "label": "Notify-me sign-up" }
    ] },
    { "id": "analytics", "label": "Analytics", "items": [
      { "check": "counter", "label": "Visitor counter on" },
      { "check": "checklist", "label": "Launch checklist passed" },
      { "check": "visit", "label": "First visit counted", "optional": true }
    ] }
  ],
  "ads": { "pictures": 2, "videos": 2 },
  "adMoney": [0, 5, 10, 25],
  "adMaxUsd": 25,
  "google": { "_comment": "Where paid Google search ads show: geo target constants (2840 is the United States) and the language constant (1000 is English).", "geo": [2840], "language": 1000 },
  "video": { "model": "google/gemini-omni-1.2-flash", "size": "720x1280", "aspect": "9:16", "minSeconds": 6, "maxSeconds": 10, "defaultSeconds": 6, "audio": false, "pollMs": 5000, "timeoutMs": 420000, "usdPerSecond": 0.0695, "perTask": 2, "perFloorDay": 6 },
  "chips": {
    "idea.researching": ["What makes a good idea?", "I already have an idea", "How does this work?"],
    "idea.pick": ["Why this idea?", "Show me other ideas", "Which one would you pick?"],
    "build": ["Show me the site so far", "Find me a .com", "What's left to do?"],
    "customers.making": ["Who are the ads for?", "What will the videos show?", "Skip ads for now"],
    "customers.money": ["Change the ads", "Skip ads for now", "Why these people?", "Should I pay for ads?"],
    "launch.free": ["How do I share the ads?", "How do I get my first customer?", "What should we do next?"],
    "launch.paid": ["What happens next with the ad?", "How do I share the ads?", "What should we do next?"]
  }
}
